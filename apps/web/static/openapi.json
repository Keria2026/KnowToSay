        "type": "string",
        "enum": [
          "search",
          "quick"
        ]
      },
      "SheetPage": {
        "type": "object",
        "required": [
          "rows",
          "total"
        ],
        "properties": {
          "rows": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SheetRow"
            }
          },
          "total": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        }
      },
      "SheetRow": {
        "type": "object",
        "required": [
          "sheet",
          "row",
          "cells"
