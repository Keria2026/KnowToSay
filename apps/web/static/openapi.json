        "properties": {
          "label": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          }
        }
      },
      "Workspace": {
        "type": "object",
        "required": [
          "groupId",
          "name",
          "role",
          "version"
        ],
        "properties": {
          "adminAddress": {
            "type": [
              "string",
              "null"
            ]
          },
          "groupId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "version": {
            "type": "integer",
            "format": "int64"
          }
        }
