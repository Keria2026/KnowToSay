        "properties": {
          "completedBytes": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "message": {
            "type": "string"
          },
          "phase": {
            "type": "string"
          },
          "totalBytes": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "version": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "Variable": {
        "type": "object",
        "required": [
          "name",
          "label",
