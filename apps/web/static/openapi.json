          "row": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "sheet": {
            "type": "string"
          }
        }
      },
      "Snapshot": {
        "type": "object",
        "required": [
          "nodes",
          "materials",
          "draftDirty"
        ],
        "properties": {
          "draftDirty": {
            "type": "boolean"
          },
          "materialCategories": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "materials": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Material"
            }
          },
          "nodes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NodeRecord"
            }
          },
          "workspace": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Workspace"
              }
            ]
          }
        }
      },
      "SyncStatus": {
        "type": "object",
        "required": [
          "phase",
          "message",
          "completedBytes",
          "totalBytes",
          "version"
